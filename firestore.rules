rules_version = '2';
// nursin.store — Firestore rules v3 (friends, levels, challenges, live rooms, weekly exams, monthly ranking, 50/50)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function optInt(d, k, mx) { return !(k in d) || (d[k] is int && d[k] >= 0 && d[k] <= mx); }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.points < 1000000
        && request.resource.data.name is string
        && request.resource.data.name.size() < 40
        && optInt(request.resource.data, 'monthPoints', 999999)
        && optInt(request.resource.data, 'powerups', 50)
        // monthKey 'YYYY-MM'; the month's ranking field m<YYYYMM> always equals monthPoints
        && (!('monthKey' in request.resource.data) || (request.resource.data.monthKey is string
            && request.resource.data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
            && request.resource.data['m' + request.resource.data.monthKey.replace('-', '')] == request.resource.data.monthPoints));
      allow delete: if signedIn() && request.auth.uid == uid;
      match /friends/{fid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }
    match /friendCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /challenges/{cid} {
      // written as two == checks (not `in [from, to]`) so the list queries where("to","==",uid) / where("from","==",uid) pass
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow update: if signedIn() && request.auth.uid in [resource.data.from, resource.data.to]
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to;
    }

    // 🔴 live rooms: only the two players write; the invited friend (or anyone with the link when nobody is invited) may take the empty seat
    match /rooms/{rid} {
      function od() { return resource.data; }
      function nd() { return request.resource.data; }
      function changed() { return nd().diff(od()).affectedKeys(); }
      function scoresOk() { return nd().hostScore is int && nd().guestScore is int && nd().hostScore >= 0 && nd().guestScore >= 0
        && nd().hostScore <= nd().qids.size() && nd().guestScore <= nd().qids.size(); }
      allow read: if signedIn() && (resource.data.host == request.auth.uid || resource.data.guest == request.auth.uid
        || resource.data.invited == request.auth.uid || (resource.data.invited == null && resource.data.guest == null));
      allow create: if signedIn() && nd().host == request.auth.uid && nd().guest == null && nd().state == 'waiting'
        && nd().invited != request.auth.uid && nd().qids is list && nd().qids.size() > 0 && nd().qids.size() <= 20
        && nd().hostScore == 0 && nd().guestScore == 0 && nd().hostPaid == false && nd().guestPaid == false
        && nd().hostName is string && nd().hostName.size() < 40;
      allow update: if signedIn()
        && nd().host == od().host && nd().invited == od().invited && nd().qids == od().qids && nd().topic == od().topic
        && nd().state in ['waiting', 'live', 'done', 'cancelled']
        && (od().state in ['waiting', 'live'] || nd().state == od().state)
        && scoresOk()
        && (!od().hostPaid || nd().hostPaid) && (!od().guestPaid || nd().guestPaid)
        && (
          (od().guest == null && od().state == 'waiting' && nd().guest == request.auth.uid && request.auth.uid != od().host
            && (od().invited == null || od().invited == request.auth.uid)
            && changed().hasOnly(['guest', 'guestName', 'guestPhoto', 'guestReady', 'guestSeen']))
          || (request.auth.uid == od().host && nd().guest == od().guest
            && changed().hasOnly(['hostReady', 'hostSeen', 'hostAns', 'hostScore', 'hostPaid', 'state', 'idx', 'qAt', 'startedAt', 'winner', 'left', 'endedAt']))
          || (od().guest != null && request.auth.uid == od().guest && nd().guest == od().guest
            && changed().hasOnly(['guestReady', 'guestSeen', 'guestAns', 'guestScore', 'guestPaid', 'state', 'idx', 'qAt', 'startedAt', 'winner', 'left', 'endedAt']))
          || (od().invited == request.auth.uid && od().guest == null && od().state == 'waiting' && nd().state == 'cancelled'
            && changed().hasOnly(['state', 'endedAt']))
        );
      allow delete: if signedIn() && resource.data.host == request.auth.uid && resource.data.state != 'live';
    }

    // 📅 weekly exams: one attempt per student per exam, open on its own day only (Lebanon day, with a few hours of slack)
    function examDay(ex) { let p = ex.split('-'); return timestamp.date(int(p[0]), int(p[1]), int(p[2])); }
    function examOpen(ex) { return request.time >= examDay(ex) - duration.value(3, 'h') && request.time < examDay(ex) + duration.value(24, 'h'); }
    function examDoc(key) { return request.resource.data.uid == request.auth.uid
      && request.resource.data.exam is string && request.resource.data.exam.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z]+$')
      && key == request.resource.data.exam + '_' + request.auth.uid
      && request.resource.data.at == request.time
      && examOpen(request.resource.data.exam); }
    match /examStarts/{key} {
      allow get: if signedIn() && key.split('_')[1] == request.auth.uid;
      allow create: if signedIn() && examDoc(key) && request.resource.data.keys().hasOnly(['uid', 'exam', 'at']);
      allow update, delete: if false;
    }
    match /examResults/{key} {
      allow get: if signedIn() && key.split('_')[1] == request.auth.uid;
      allow create: if signedIn() && examDoc(key)
        && exists(/databases/$(database)/documents/examStarts/$(key))
        && request.resource.data.keys().hasOnly(['uid', 'exam', 'score', 'total', 'at'])
        && request.resource.data.total is int && request.resource.data.total >= 1 && request.resource.data.total <= 20
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total;
      allow update, delete: if false;
    }
  }
}
