rules_version = '2';
// nursin.store — Firestore rules v4 (friends, levels, challenges, live rooms, weekly exams, monthly ranking, 50/50, classes)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function optInt(d, k, mx) { return !(k in d) || (d[k] is int && d[k] >= 0 && d[k] <= mx); }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.points < 1000000
        && request.resource.data.name is string
        && request.resource.data.name.size() < 40
        && optInt(request.resource.data, 'monthPoints', 999999)
        && optInt(request.resource.data, 'powerups', 50)
        // monthKey 'YYYY-MM'; the month's ranking field m<YYYYMM> always equals monthPoints
        && (!('monthKey' in request.resource.data) || (request.resource.data.monthKey is string
            && request.resource.data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
            && request.resource.data['m' + request.resource.data.monthKey.replace('-', '')] == request.resource.data.monthPoints));
      allow delete: if signedIn() && request.auth.uid == uid;
      match /friends/{fid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
      // v4: the student's own list of classes (index only; the class itself decides who is a member)
      match /myClasses/{cid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'owner', 'at'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      }
    }
    match /friendCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /challenges/{cid} {
      // written as two == checks (not `in [from, to]`) so the list queries where("to","==",uid) / where("from","==",uid) pass
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow update: if signedIn() && request.auth.uid in [resource.data.from, resource.data.to]
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to;
    }

    // 🔴 live rooms: only the two players write; the invited friend (or anyone with the link when nobody is invited) may take the empty seat
    match /rooms/{rid} {
      function od() { return resource.data; }
      function nd() { return request.resource.data; }
      function changed() { return nd().diff(od()).affectedKeys(); }
      function scoresOk() { return nd().hostScore is int && nd().guestScore is int && nd().hostScore >= 0 && nd().guestScore >= 0
        && nd().hostScore <= nd().qids.size() && nd().guestScore <= nd().qids.size(); }
      allow read: if signedIn() && (resource.data.host == request.auth.uid || resource.data.guest == request.auth.uid
        || resource.data.invited == request.auth.uid || (resource.data.invited == null && resource.data.guest == null));
      allow create: if signedIn() && nd().host == request.auth.uid && nd().guest == null && nd().state == 'waiting'
        && nd().invited != request.auth.uid && nd().qids is list && nd().qids.size() > 0 && nd().qids.size() <= 20
        && nd().hostScore == 0 && nd().guestScore == 0 && nd().hostPaid == false && nd().guestPaid == false
        && nd().hostName is string && nd().hostName.size() < 40;
      allow update: if signedIn()
        && nd().host == od().host && nd().invited == od().invited && nd().qids == od().qids && nd().topic == od().topic
        && nd().state in ['waiting', 'live', 'done', 'cancelled']
        && (od().state in ['waiting', 'live'] || nd().state == od().state)
        && scoresOk()
        && (!od().hostPaid || nd().hostPaid) && (!od().guestPaid || nd().guestPaid)
        && (
          (od().guest == null && od().state == 'waiting' && nd().guest == request.auth.uid && request.auth.uid != od().host
            && (od().invited == null || od().invited == request.auth.uid)
            && changed().hasOnly(['guest', 'guestName', 'guestPhoto', 'guestReady', 'guestSeen']))
          || (request.auth.uid == od().host && nd().guest == od().guest
            && changed().hasOnly(['hostReady', 'hostSeen', 'hostAns', 'hostScore', 'hostPaid', 'state', 'idx', 'qAt', 'startedAt', 'winner', 'left', 'endedAt']))
          || (od().guest != null && request.auth.uid == od().guest && nd().guest == od().guest
            && changed().hasOnly(['guestReady', 'guestSeen', 'guestAns', 'guestScore', 'guestPaid', 'state', 'idx', 'qAt', 'startedAt', 'winner', 'left', 'endedAt']))
          || (od().invited == request.auth.uid && od().guest == null && od().state == 'waiting' && nd().state == 'cancelled'
            && changed().hasOnly(['state', 'endedAt']))
        );
      allow delete: if signedIn() && resource.data.host == request.auth.uid && resource.data.state != 'live';
    }

    // 📅 weekly exams: one attempt per student per exam, open on its own day only (Lebanon day, with a few hours of slack)
    function examDay(ex) { let p = ex.split('-'); return timestamp.date(int(p[0]), int(p[1]), int(p[2])); }
    function examOpen(ex) { return request.time >= examDay(ex) - duration.value(3, 'h') && request.time < examDay(ex) + duration.value(24, 'h'); }
    function examDoc(key) { return request.resource.data.uid == request.auth.uid
      && request.resource.data.exam is string && request.resource.data.exam.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z]+$')
      && key == request.resource.data.exam + '_' + request.auth.uid
      && request.resource.data.at == request.time
      && examOpen(request.resource.data.exam); }
    match /examStarts/{key} {
      allow get: if signedIn() && key.split('_')[1] == request.auth.uid;
      allow create: if signedIn() && examDoc(key) && request.resource.data.keys().hasOnly(['uid', 'exam', 'at']);
      allow update, delete: if false;
    }
    match /examResults/{key} {
      allow get: if signedIn() && key.split('_')[1] == request.auth.uid;
      allow create: if signedIn() && examDoc(key)
        && exists(/databases/$(database)/documents/examStarts/$(key))
        && request.resource.data.keys().hasOnly(['uid', 'exam', 'score', 'total', 'at'])
        && request.resource.data.total is int && request.resource.data.total >= 1 && request.resource.data.total <= 20
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total;
      allow update, delete: if false;
    }

    // 🏫 v4 classes «الصفوف»: members-only reads, owner-only admin, one exam per class per ISO week, one result per student per week
    function classPath(cid) { return /databases/$(database)/documents/classes/$(cid); }
    function codePath(code) { return /databases/$(database)/documents/classCodes/$(code); }
    function isMember(cid) { return signedIn() && exists(/databases/$(database)/documents/classes/$(cid)/members/$(request.auth.uid)); }
    function isClassOwner(cid) { return signedIn() && get(classPath(cid)).data.owner == request.auth.uid; }
    function codeOk(c) { return c is string && c.matches('^[A-Z0-9]{6}$'); }
    function nameOk(n) { return n is string && n.size() > 0 && n.size() <= 40; }
    match /classCodes/{code} {
      allow get: if signedIn();                                   // you need the code to find the class
      allow list: if false;
      allow create: if signedIn() && codeOk(code)
        && request.resource.data.keys().hasOnly(['cid', 'name']) && nameOk(request.resource.data.name)
        && getAfter(classPath(request.resource.data.cid)).data.owner == request.auth.uid
        && getAfter(classPath(request.resource.data.cid)).data.code == code;
      allow update: if false;
      allow delete: if signedIn() && getAfter(classPath(resource.data.cid)).data.owner == request.auth.uid
        && getAfter(classPath(resource.data.cid)).data.code != code;   // only an old code, after the owner made a new one
    }
    match /classes/{cid} {
      allow read: if isMember(cid) || (signedIn() && resource.data.owner == request.auth.uid);
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'owner', 'ownerName', 'code', 'createdAt'])
        && nameOk(request.resource.data.name) && codeOk(request.resource.data.code)
        && request.resource.data.ownerName is string && request.resource.data.ownerName.size() < 40
        && getAfter(codePath(request.resource.data.code)).data.cid == cid;
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'code'])
        && nameOk(request.resource.data.name) && codeOk(request.resource.data.code)
        && getAfter(codePath(request.resource.data.code)).data.cid == cid;
      allow delete: if false;

      match /members/{uid} {
        function memberOk(d) { return d.name is string && d.name.size() < 40 && d.photo is string && d.photo.size() <= 500
          && d.level is int && d.level >= 1 && d.level <= 1000; }
        allow read: if isMember(cid);
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'photo', 'level', 'code', 'joinedAt'])
          && memberOk(request.resource.data) && codeOk(request.resource.data.code)
          && getAfter(codePath(request.resource.data.code)).data.cid == cid;   // joined with the class's current code
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo', 'level'])
          && memberOk(request.resource.data);
        allow delete: if signedIn() && (request.auth.uid == uid || isClassOwner(cid));   // leave, or the owner removes
      }
      match /weeks/{wk} {
        allow read: if isMember(cid);
        allow create: if isMember(cid) && wk.matches('^[0-9]{4}-W[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['wk', 'qids', 'topics', 'intro', 'src', 'by', 'createdAt'])
          && request.resource.data.wk == wk && request.resource.data.by == request.auth.uid
          && request.resource.data.qids is list && request.resource.data.qids.size() >= 5 && request.resource.data.qids.size() <= 20
          && request.resource.data.topics is list && request.resource.data.topics.size() <= 8
          && request.resource.data.intro is string && request.resource.data.intro.size() <= 400
          && request.resource.data.src in ['ai', 'auto'];
        allow update, delete: if false;
      }
      match /starts/{key} {
        allow read: if isMember(cid);
        allow create: if isMember(cid) && request.resource.data.uid == request.auth.uid
          && key == request.resource.data.wk + '_' + request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'wk', 'at']) && request.resource.data.at == request.time
          && exists(/databases/$(database)/documents/classes/$(cid)/weeks/$(request.resource.data.wk));
        allow update, delete: if false;
      }
      match /results/{key} {
        allow read: if isMember(cid);
        allow create: if isMember(cid) && request.resource.data.uid == request.auth.uid
          && key == request.resource.data.wk + '_' + request.auth.uid
          && exists(/databases/$(database)/documents/classes/$(cid)/starts/$(key))
          && request.resource.data.keys().hasOnly(['uid', 'wk', 'name', 'photo', 'score', 'total', 'wrongQ', 'wrongT', 'at'])
          && request.resource.data.at == request.time
          && request.resource.data.name is string && request.resource.data.name.size() < 40
          && request.resource.data.photo is string && request.resource.data.photo.size() <= 500
          && request.resource.data.total is int && request.resource.data.total >= 1 && request.resource.data.total <= 20
          && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total
          && request.resource.data.wrongQ is list && request.resource.data.wrongQ.size() <= 20
          && request.resource.data.wrongT is list && request.resource.data.wrongT.size() <= 20;
        allow update, delete: if false;
      }
    }
  }
}
